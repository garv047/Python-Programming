#frozenset-immutable
#frozenset is fixed (read only) set
fs1 = frozenset([1, 2, 3])
print("original:", fs1, "id:", id(fs1))
fs1 = fs1.union({4}) #adding element:- union
print("modified:", fs1, "id:", id(fs1))
fs2 = frozenset([3, 4])
print(fs1 | fs2) #union
print(fs1 & fs2) #intersection
print(fs1 - fs2) #difference - remove all common element
print(fs2 - fs1)
print(2 in fs1) #check 2 in fs1
print(5 in fs2) #check 5 in fs2
#attribute errors  fs1.add(4)  fs1.remove(1) fs1.update([5])
