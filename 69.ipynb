# 7- todo list
tasks = []

def add_task():
    task = input("Enter task: ")
    tasks.append(task)
    print("Task added.")

def view_tasks():
    if not tasks:
        print("No tasks.")
    else:
        for i, t in enumerate(tasks, start=1):
            print(i, ":", t)

def remove_task():
    view_tasks()
    if tasks:
        idx = int(input("Enter task number to remove: "))
        if 1 <= idx <= len(tasks):
            removed = tasks.pop(idx - 1)
            print("Removed:", removed)
        else:
            print("Invalid task number.")

while True:
    print("\n1.Add  2.View  3.Remove  4.Exit")
    ch = input("Choice: ")

    if ch == "1":
        add_task()
    elif ch == "2":
        view_tasks()
    elif ch == "3":
        remove_task()
    elif ch == "4":
        break
    else:
        print("Invalid choice")
