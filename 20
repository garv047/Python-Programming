#format() method

#using commas in print (not formatting)
language = "Python"
version = 3.12
print("language:", language, "version:", version)

#using format() with automatic placeholders
print("language:{} version:{}".format(language, version))

#using format() with positional indexes
print("version:{1} language:{0}".format(language, version))

#using named placeholders
print("language:{lang} version:{ver}".format(lang=language, ver=version))

#formatting numbers(precision)
pi = 3.1415926535
print("value of PI: {:.2f}".format(pi))

#width and alignment
'''
width specifies the minimum number of character spaces reserved for a value when it is displayed.
if the actual value is shorter than width, extra spaces are added.
if value is longer than width, it is printed completely (not truncated).
'''
print("language:{:<10}, center-aligned:{:^10}, version:{:>5}".format(language, language, version))
