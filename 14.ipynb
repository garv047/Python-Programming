#bool-immutable
a = True
print("original:", a, "id:", id(a))
a = not a #a become false as not true
print(":modified", a, "id:", id(a))
b = False
print(a and b)
print(a or b)
print(not a)
print(a == b)
a = not a + 1 # + is dominant over not
#false + 1 = true (and vice versa)
print(a)
#a +=1 is type error
#a[0] is type error
