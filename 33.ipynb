#exp2-finding roots of quadratic
a = int(input("enter co-efficient of x²: "))
b = int(input("enter co-efficient of x: "))
c = int(input("enter constant: "))
d = (b * b) - (4 * a * c)
if d >= 0:
 print("roots are real")
 print((- b + (d ** 0.5)) / (2 * a))
 print((- b - (d ** 0.5)) / (2 * a))
else:
  print("roots are imaginary")
